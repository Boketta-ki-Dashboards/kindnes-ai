{
  "video": {
    "width": 1080,
    "height": 1920,
    "fps": 30,
    "crf": 18,
    "audioBitrate": "192k",
    "x264Preset": "medium"
  },
  "story": {
    "minSec": 12,
    "maxSec": 40,
    "reactionHoldSec": 2.0,
    "framing": "fit-blur",
    "fitZoom": 1.0,
    "kenBurns": 0.05,
    "snapCutsToBeats": true
  },
  "audio": {
    "musicGainDb": -7,
    "storyMusic": {
      "startDb": -20,
      "bodyDb": -18,
      "riseSec": 4,
      "fadeInSec": 0.4,
      "buildUpBeats": 6
    },
    "ducking": {
      "enabled": true,
      "depthDb": 6,
      "attackSec": 0.15,
      "releaseSec": 0.45,
      "holdSec": 0.15
    },
    "muteStoryIfSongDetected": true,
    "songDetectSimilarity": 0.85,
    "storyAudioGain": 0.9,
    "storyLevel": {
      "mode": "auto",
      "targetSpeechRmsDb": -20,
      "minGainDb": -6,
      "maxGainDb": 12
    },
    "storyFadeAtDropSec": 0.5,
    "musicFadeInSec": 0.3,
    "targetLufs": -14,
    "normalizeOn": "outro"
  },
  "outro": {
    "variant": "A",
    "bars": 6,
    "fadeOutSec": 0.6,
    "cutLeadFrames": 2
  },
  "transition": {
    "type": "flash",
    "durationFrames": 8
  },
  "text": {
    "dropCaption": "kindness.",
    "showDropCaption": true,
    "font": "Inter",
    "dictionary": {
      "anchor": "bottom",
      "bodyPx": 36,
      "fadeInDelaySec": 0.3,
      "fadeInDurationSec": 0.25,
      "highlightIncludesPeriod": false
    }
  },
  "scoring": {
    "threshold": 75,
    "visionReview": {
      "enabled": false,
      "model": "claude-opus-5-5",
      "frames": 12,
      "effort": "medium",
      "maxPerRun": 10
    }
  },
  "discovery": {
    "maxResultsPerQuery": 12,
    "queriesPerRun": 10,
    "minDurationSec": 8,
    "maxDurationSec": 600,
    "adapters": {
      "youtube": {
        "enabled": true
      },
      "dailymotion": {
        "enabled": true
      },
      "archive_org": {
        "enabled": true
      },
      "wikimedia": {
        "enabled": true
      },
      "reddit": {
        "enabled": true
      }
    }
  },
  "acquisition": {
    "allowLicensedDownloads": true,
    "ytDlp": {
      "enabled": false,
      "requireCreativeCommons": true
    },
    "maxDownloadMb": 300
  },
  "render": {
    "browserExecutable": null,
    "concurrency": null
  }
}
